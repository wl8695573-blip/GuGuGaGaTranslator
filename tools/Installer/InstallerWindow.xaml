<Window x:Class="GuGuGaGaTranslator.Installer.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/icon.png"
        Title="安装 GuGuGaGaTranslator"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF0F1430" Foreground="#FFEDF1FF"
        FontFamily="YouYuan, 幼圆, Microsoft YaHei UI, Segoe UI">
  <StackPanel Margin="24,20,24,20">

    <StackPanel Orientation="Horizontal">
      <Image Source="Assets/icon.png" Width="56" Height="56" VerticalAlignment="Center"
             RenderOptions.BitmapScalingMode="HighQuality" />
      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="GuGuGaGaTranslator" FontSize="21" FontWeight="Bold" />
        <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="#FFA6B0DC" />
      </StackPanel>
    </StackPanel>

    <TextBlock x:Name="IntroText" Margin="0,18,0,0" TextWrapping="Wrap" FontSize="12.5"
               Foreground="#FFC0C8E8" />

    <TextBlock Text="安装到" Margin="0,18,0,2" FontSize="11.5" Foreground="#FFA6B0DC" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="PathBox" Grid.Column="0" Padding="6,5" />
      <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览…" Margin="6,0,0,6"
              Click="OnBrowse" Padding="10,5" />
    </Grid>

    <CheckBox x:Name="DesktopShortcutCheck" Content="创建桌面快捷方式" IsChecked="True" Margin="0,6,0,0" />
    <CheckBox x:Name="StartMenuShortcutCheck" Content="添加到开始菜单" IsChecked="True" Margin="0,2,0,0" />
    <CheckBox x:Name="LaunchCheck" Content="安装完成后立即运行" IsChecked="True" Margin="0,2,0,0" />

    <TextBlock x:Name="StatusText" Margin="0,16,0,0" TextWrapping="Wrap" FontSize="12"
               Foreground="#FF7C87B8" Text="点击「安装」开始。整个程序会被复制到上面这个目录,不会改动系统设置。" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="CancelButton" Content="取消" Click="OnCancel" MinWidth="88" Padding="12,7" Margin="0,0,8,0" />
      <Button x:Name="InstallButton" Content="安装" Click="OnInstall" MinWidth="110" Padding="14,7"
              Background="#FF5B7BFF" Foreground="White" BorderBrush="#FF8FA8FF" BorderThickness="1" />
    </StackPanel>

  </StackPanel>
</Window>
