<Application x:Class="GuGuGaGaTranslator.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinWidth" Value="80" />
      <Setter Property="Foreground" Value="#FFEDF1FF" />
      <Setter Property="Background" Value="#FF1E2757" />
      <Setter Property="BorderBrush" Value="#FF2C3873" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FF0B1029" />
      <Setter Property="Foreground" Value="#FFEDF1FF" />
      <Setter Property="BorderBrush" Value="#FF2C3873" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#FFEDF1FF" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Application.Resources>
</Application>
