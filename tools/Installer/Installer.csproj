<Project Sdk="Microsoft.NET.Sdk">

  <!-- The installer that ships in GitHub Releases. It carries the published
       application as an embedded zip, so a download is one file that installs
       without a network connection and without administrator rights. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GuGuGaGaTranslator.Installer</RootNamespace>
    <AssemblyName>LCTA-Setup</AssemblyName>
    <Title>LCTA 安装程序</Title>
    <Product>LCTA</Product>
    <ApplicationIcon>..\..\src\GuGuGaGaTranslator.App\Assets\icon.ico</ApplicationIcon>

  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\src\GuGuGaGaTranslator.App\Assets\icon.png" Link="Assets\icon.png" />
    <Resource Include="..\..\src\GuGuGaGaTranslator.App\Assets\lcta-wordmark.png" Link="Assets\lcta-wordmark.png" />
    <Resource Include="..\..\src\GuGuGaGaTranslator.App\Assets\app-wordmark.png" Link="Assets\app-wordmark.png" />
  </ItemGroup>

  <!-- build.ps1 -Installer drops the published zip here; the folder is not in git. -->
  <ItemGroup Condition="Exists('payload\app.zip')">
    <EmbeddedResource Include="payload\app.zip" LogicalName="payload.app.zip" />
  </ItemGroup>

  <ItemGroup><Compile Include="..\..\src\Shared\InstallationManifest.cs" Link="InstallationManifest.cs" /></ItemGroup>
</Project>
