<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console harness for verifying the pipeline without the GUI. This is how
       the work gets checked on a machine whose screen the agent cannot see:
       capture a real window, dump the PNG, run OCR, print the JSON. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GuGuGaGaTranslator.Probe</RootNamespace>
    <AssemblyName>gugugaga-probe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GuGuGaGaTranslator.Core\GuGuGaGaTranslator.Core.csproj" />
    <ProjectReference Include="..\..\src\GuGuGaGaTranslator.Ocr.Rapid\GuGuGaGaTranslator.Ocr.Rapid.csproj" />
  </ItemGroup>

</Project>
