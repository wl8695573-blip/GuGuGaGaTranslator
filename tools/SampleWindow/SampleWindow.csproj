<Project Sdk="Microsoft.NET.Sdk">

  <!-- A controllable translation target: a borderless dialogue box with
       Japanese, English, and Chinese lines, optionally cycling its text. It
       exists so capture, change detection, and OCR can be verified against a
       real window instead of a hand-made image, and so the pipeline has a
       repeatable fixture that needs no game installed. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GuGuGaGaTranslator.SampleWindow</RootNamespace>
    <AssemblyName>gugugaga-sample-window</AssemblyName>
  </PropertyGroup>

</Project>
