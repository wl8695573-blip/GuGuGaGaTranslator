<Window x:Class="GuGuGaGaTranslator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/icon.png"
        Title="GuGuGaGaTranslator · 屏幕实时翻译"
        Height="780" Width="1140"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="380" MinWidth="300" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 目标窗口 -->
    <DockPanel Grid.Column="0" Margin="0,0,14,0">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
        <Image Source="Assets/icon.png" Width="30" Height="30" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="1 · 选择要翻译的窗口" Style="{StaticResource TitleText}" VerticalAlignment="Center"
                   Margin="8,0,0,0" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Top" x:Name="TargetSummary" Style="{StaticResource FieldLabel}"
                 TextWrapping="Wrap" Text="尚未选择窗口" />
      <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,6,0,4">
        <Button x:Name="RefreshButton" Content="刷新列表" Click="OnRefreshWindows" />
        <Button x:Name="RegionButton" Content="框选区域" Click="OnPickRegion" />
      </UniformGrid>
      <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,0,8">
        <Button x:Name="BottomStripButton" Content="底部对话框(一键)" Click="OnPickBottomStrip"
                ToolTip="按 galgame 的常见布局,自动把区域设在窗口底部约 30% 的横条上,之后可再用「框选区域」微调" />
        <Button x:Name="ClearRegionButton" Content="清除区域" Click="OnClearRegion" />
      </UniformGrid>
      <CheckBox x:Name="HideOwnWindowsCheck" DockPanel.Dock="Top" Margin="0,0,0,8"
                Content="框选时隐藏翻译界面(推荐)"
                Checked="OnHideOwnWindowsChanged" Unchecked="OnHideOwnWindowsChanged"
                ToolTip="和微信截图一样:一进框选就把控制窗口、翻译框和语言条收起来,框到的就是你看到的那块屏幕;框完自动恢复。框选框里也有同一个开关,可以当场改。" />
      <ListView x:Name="WindowList" DisplayMemberPath="Display"
                SelectionChanged="OnWindowSelected" />
    </DockPanel>

    <TabControl x:Name="SettingsTabs" Grid.Column="1">

      <TabItem Header="运行">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Orientation="Horizontal">
            <Button x:Name="StartButton" Content="开始翻译" Click="OnStart" Style="{StaticResource PrimaryButton}" />
            <Button x:Name="PauseButton" Content="暂停" Click="OnPause" />
            <Button x:Name="StopButton" Content="停止" Click="OnStop" />
            <Button x:Name="SaveButton" Content="保存配置" Click="OnSave" />
          </StackPanel>

          <TextBlock Grid.Row="1" x:Name="StatusText" Text="就绪" Margin="0,10,0,0"
                     TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />

          <TextBlock Grid.Row="2" Text="识别到的原文" Style="{StaticResource FieldLabel}" Margin="0,12,0,2" />

          <TextBox Grid.Row="3" x:Name="SourceBox" IsReadOnly="True" AcceptsReturn="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   Foreground="{StaticResource SourceTextBrush}"
                   FontFamily="Consolas, Microsoft YaHei UI" />

          <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="译文(悬浮层显示的内容)" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="TranslationBox" IsReadOnly="True" AcceptsReturn="True" Height="150"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="18"
                     Foreground="{StaticResource TextBrush}"
                     FontFamily="Microsoft YaHei UI, Meiryo, Yu Gothic" />
            <TextBlock x:Name="StatsText" Margin="0,8,0,0" Foreground="{StaticResource HintTextBrush}"
                       TextWrapping="Wrap" Text="帧 0 · 识别 0 · 翻译 0 · 缓存 0 · 去重 0 · 错误 0" />
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="识别与翻译">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">

            <TextBlock Text="识别" Style="{StaticResource SectionText}" />
            <TextBlock Text="识别引擎" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="OcrEngineCombo" SelectionChanged="OnOcrEngineChanged" />
            <TextBlock x:Name="OcrEngineSummary" Style="{StaticResource HintText}" />
            <TextBlock Text="识别语言" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="OcrLanguageCombo" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="Windows OCR 请优先选择画面文字对应的语言；auto 会依次尝试多种语言，耗时更长。RapidOCR 不使用此设置。" />
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="识别前放大倍数（小字建议 2–3）" />
                <TextBox x:Name="OcrScaleBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="对比度增强（正常画面保持 0）" />
                <TextBox x:Name="OcrGrayBox" />
              </StackPanel>
            </UniformGrid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button x:Name="OpenLanguageSettingsButton" Content="打开 Windows 语言设置"
                      Click="OnOpenLanguageSettings" />
              <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="6,0,0,0"
                         Text="装完「光学字符识别」功能要重启本程序" />
            </StackPanel>
            <TextBlock Text="RapidOCR 设置" Style="{StaticResource FieldLabel}" />
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="短边目标（数值越小，检测越快）" />
                <TextBox x:Name="RapidLimitSideBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="模型目录（留空时使用应用目录下的 models\v6）" />
                <TextBox x:Name="RapidModelsBox" />
              </StackPanel>
            </UniformGrid>

            <Separator Margin="0,10,0,10" />

            <TextBlock Text="翻译方向" Style="{StaticResource SectionText}" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="这两个设置仅用于翻译。源语言选择 auto 时，由翻译引擎判断语言。" />
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="源语言(原文)" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="FromCombo" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Text="目标语言(译文)" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ToCombo" />
              </StackPanel>
            </UniformGrid>

            <Separator Margin="0,10,0,10" />

            <TextBlock Text="翻译引擎" Style="{StaticResource SectionText}" />
            <TextBlock Text="翻译引擎" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ProviderCombo" SelectionChanged="OnProviderChanged" />
            <TextBlock x:Name="ProviderCapabilitiesText" Style="{StaticResource HintText}" />
            <StackPanel x:Name="ClassicCredentialsPanel" Visibility="Collapsed">
              <StackPanel x:Name="ClassicIdPanel">
                <TextBlock Text="应用 ID / appKey" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ClassicIdBox" />
              </StackPanel>
              <TextBlock Text="应用密钥 / token（Windows 当前账户加密保存）" Style="{StaticResource FieldLabel}" />
              <PasswordBox x:Name="ClassicSecretBox" />
              <Button Content="打开服务商密钥页面" Click="OnGetApiKey" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel x:Name="AISettingsPanel">
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="常用预设（自动填写接口地址和模型）" />
            <ComboBox x:Name="PresetCombo" SelectionChanged="OnPresetChanged" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="指令格式（通用模型使用 galgame；Sakura-GalTransl 使用 sakura）" />
            <ComboBox x:Name="PromptStyleCombo" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="上下文句数（0 表示关闭）" />
            <TextBox x:Name="HistoryLinesBox" />
            <Button x:Name="SetupButton" Content="API 设置…（填写 Key / 测试连接）" Click="OnOpenSetup" Margin="0,6,0,6" Style="{StaticResource PrimaryButton}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button x:Name="GetKeyButton" Content="获取 API Key" Click="OnGetApiKey" />
              <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="6,0,0,0"
                         Text="在线服务通常需要 Key；本地模型可留空。价格和额度请以服务商页面为准。" />
            </StackPanel>

            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="接口地址（程序会自动追加 /chat/completions）" />
            <TextBox x:Name="BaseUrlBox" LostFocus="OnEngineFieldChanged" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="模型名" />
            <TextBox x:Name="ModelBox" LostFocus="OnEngineFieldChanged" />
            <TextBlock Text="API Key（本地引擎留空）" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="ApiKeyBox" />
            </StackPanel>
            <TextBlock x:Name="EngineSummary" Foreground="{StaticResource HintTextBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,10" />
            <Button Content="清除已保存密钥" Click="OnClearApiKey" HorizontalAlignment="Left" />
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                           Text="超时（秒）" />
                <TextBox x:Name="TimeoutBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                           Text="温度（0 最稳定）" />
                <TextBox x:Name="TemperatureBox" />
              </StackPanel>
            </UniformGrid>
            <Button x:Name="TestProviderButton" Content="测试当前服务连接" Click="OnTestProvider"
                    HorizontalAlignment="Left" Margin="0,6,0,0" />
            <TextBlock Style="{StaticResource HintText}" Text="测试会把一条示例文本发给当前服务，可能产生少量用量。" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="游戏模式">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">

            <TextBlock Text="游戏专属模式" Style="{StaticResource SectionText}" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="游戏档案可提供术语表、世界观和风格要求。启用术语校正后，已列出的错误译法会在译后替换。" />

            <TextBlock Text="当前生效的游戏档案" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="GameProfileCombo" SelectionChanged="OnGameProfileChanged" />
            <UniformGrid Columns="3" Margin="0,6,0,6">
              <Button x:Name="EditProfileButton" Content="编辑术语表…" Click="OnEditGameProfile" />
              <Button x:Name="NewProfileButton" Content="新建档案…" Click="OnNewGameProfile" />
              <Button x:Name="GenerateSheetButton" Content="生成术语表…" Click="OnGenerateTermSheet" Style="{StaticResource PrimaryButton}" />
            </UniformGrid>
            <UniformGrid Columns="2" Margin="0,0,0,6">
              <Button Content="导入档案…" Click="OnImportProfile" />
              <Button Content="导出当前档案…" Click="OnExportProfile" />
            </UniformGrid>
            <TextBlock Style="{StaticResource HintText}" Text="档案文件只包含作品设定、术语和来源信息；导入后可先编辑再保存。" />
            <TextBlock x:Name="GameProfileSummary" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
            <Button x:Name="PreviewPromptButton" Content="查看实际发送给 AI 的提示词…" Click="OnPreviewPrompt" Margin="0,6,0,0" />

            <Separator Margin="0,10,0,10" />

            <CheckBox x:Name="AutoProfileCheck" Content="按游戏窗口标题自动切换档案" Click="OnProfileOptionChanged" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="在下面「目标窗口」里选中游戏之后,只要窗口标题里含某个档案的关键字,就自动切到那份档案。" />
            <CheckBox x:Name="EnforceTermsCheck" Content="术语强制校正(推荐开着)" Click="OnProfileOptionChanged" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="将已列出的禁止译法替换为既定译名，并补齐未翻译术语。" />

            <Separator Margin="0,10,0,10" />

            <TextBlock Text="术语表的写法" Style="{StaticResource SectionText}" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="每行一条:原文 = 译名 | 禁止: 错误译法1、错误译法2     (# 开头是注释)" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="行首可以标语言:en: / ja: / zh:。这样一张表能同时装几种原文,翻译时按当前方向自动取用 —— 译成中文就取源语言那一列,中文译成外语则反过来用,两种外语互译时以中间的中文译名为枢轴自动配对。不标语言的行按「任意外语 → 中文」处理。" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="en: Outis = 奥提斯 | 禁止: 奥德修斯、奥蒂斯" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="ja: ウーティス = 奥提斯 | 禁止: 奥德修斯、奥蒂斯" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="「=」两边写一样,意思是「这个词必须原样保留,不许意译」(例如日文的「良秀」就是中文的「良秀」)。「禁止」里的写法一旦出现在译文里,会被立刻改回右边的译名 —— 而且「禁止」列写的必须是**译文语言**的写法。想手改的话,直接编辑配置文件里的 translation.gameProfiles 也可以。" />

            <Separator Margin="0,10,0,10" />

            <TextBlock Text="自己写一款新游戏" Style="{StaticResource SectionText}" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="1. 点「新建档案…」,填名称(例如 边狱巴士 / Limbus Company)。" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="2. 点击“生成 / 补全术语表”。AI 会按官方简中译名起草；游戏名留空时，会根据台词尝试识别作品。" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="3. 自己看一遍,把译错的改掉、把常见误译填进「禁止」。之后每次玩这款游戏,它都会自动按这套译名翻译。" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="世界观应简短说明作品和主要设定。" />

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="悬浮层">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">

            <TextBlock Text="外观预设" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="OverlayPresetCombo" SelectionChanged="OnOverlayPresetChanged" />
            <TextBlock x:Name="OverlayPresetSummary" Foreground="{StaticResource HintTextBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,10" />

            <TextBlock Text="翻译框位置" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="PlacementCombo" SelectionChanged="OnOverlayFieldChanged" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="遮盖原文 = 翻译框盖在原对话框上(galgame 最常见);下方 / 上方 = 保留原文,译文贴在对话框下沿或上沿。" />

            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="字号" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="OverlayFontBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Text="背景不透明度(0–1)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="OverlayOpacityBox" />
              </StackPanel>
            </UniformGrid>
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="水平偏移" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="OverlayOffsetXBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Text="垂直偏移(负值上移)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="OverlayOffsetYBox" />
              </StackPanel>
            </UniformGrid>
            <CheckBox x:Name="ShowPanelCheck" Content="显示翻译框底框(关掉只剩带描边的文字)" />
            <CheckBox x:Name="ShowSourceCheck" Content="同时显示识别到的原文" />
            <CheckBox x:Name="TextOutlineCheck" Content="文字描边(底框关掉后靠它保证可读)" />
            <CheckBox x:Name="ClickThroughCheck" Content="鼠标穿透(关闭后才能拖动悬浮层)" />
            <CheckBox x:Name="LanguageBarCheck" Content="在悬浮层上方显示语言切换条" />
            <CheckBox x:Name="ExcludeFromCaptureCheck" Content="翻译框不被录屏/截图拍到(想录下翻译过程就取消勾选)"
                      Checked="OnExcludeFromCaptureChanged" Unchecked="OnExcludeFromCaptureChanged" />
            <Separator Margin="0,8,0,8" />
            <TextBlock Text="翻译框宽 / 高(像素;0 = 宽跟随所选区域、高随文字)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBox x:Name="OverlayWidthBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBox x:Name="OverlayHeightBox" />
              </StackPanel>
            </UniformGrid>
            <TextBlock Text="最大行数（0 不限制） / 圆角 / 内边距" Style="{StaticResource FieldLabel}" />
            <UniformGrid Columns="3">
              <StackPanel Margin="0,0,6,0">
                <TextBox x:Name="OverlayMaxLinesBox" />
              </StackPanel>
              <StackPanel Margin="3,0,3,0">
                <TextBox x:Name="OverlayCornerBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBox x:Name="OverlayPaddingBox" />
              </StackPanel>
            </UniformGrid>
            <TextBlock Text="字体(留空 = 系统默认)" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="OverlayFontFamilyBox" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="全部外观都能在 config.json 的 overlay 段里改;想加一套新外观,往 overlay.presets 里加一条即可,不用改代码。" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="热键">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="全局快捷键" Style="{StaticResource SectionText}" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="点击输入框后直接按组合键。组合键至少包含 Ctrl、Alt、Shift 或 Win；Backspace 清除，Esc 取消录入。" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="“一键框选并翻译”会在确认选区后开始翻译；未选择目标窗口时使用当前前台窗口。" />
            <StackPanel x:Name="HotkeyRows" Margin="0,14,0,0" />
            <Button x:Name="HotkeyResetButton" Content="恢复默认快捷键" Click="OnResetHotkeys"
                    HorizontalAlignment="Left" Padding="10,6" />
            <TextBlock x:Name="HotkeyStatus" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="缓存与支持">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="翻译缓存" Style="{StaticResource SectionText}" />
            <CheckBox x:Name="PersistentCacheCheck" Content="把翻译缓存保存在本机，重启后仍可复用（可选）" />
            <TextBlock x:Name="CacheStatusText" Style="{StaticResource HintText}" />
            <TextBlock Style="{StaticResource HintText}" Text="默认仅使用内存。磁盘缓存只保存请求的哈希和 Windows 当前账户加密的译文；关闭后停止读写，已有缓存可用下方按钮删除。" />
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="磁盘保留天数（1–365）" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="CacheRetentionBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Text="最大磁盘条数（100–100000）" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="CacheCapacityBox" />
              </StackPanel>
            </UniformGrid>
            <WrapPanel Margin="0,6,0,0">
              <Button Content="应用缓存设置" Click="OnSave" />
              <Button x:Name="ClearCacheButton" Content="删除内存和磁盘缓存" Click="OnClearCache" />
            </WrapPanel>
            <Separator Margin="0,16,0,16" />
            <TextBlock Text="诊断与支持" Style="{StaticResource SectionText}" />
            <TextBlock Style="{StaticResource HintText}" Text="诊断包包含版本、系统、脱敏设置、状态和耗时日志。不包含 API Key、接口地址、窗口标题、截图、台词、译文或游戏档案；不会自动上传。" />
            <Button Content="导出诊断包…" Click="OnExportDiagnostics" HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="调试">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <CheckBox x:Name="DumpFramesCheck" Content="把每一帧识别证据写到磁盘(PNG + JSON)" />
            <TextBlock Text="证据目录" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="DumpDirBox" />
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="保留最近多少对" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="DumpKeepBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Text="轮询间隔(毫秒)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="PollIntervalBox" />
              </StackPanel>
            </UniformGrid>
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="变化阈值(256 格中变了多少格才重新识别)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                <TextBox x:Name="ChangeThresholdBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Text="强制刷新间隔(毫秒)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ForceRefreshBox" />
              </StackPanel>
            </UniformGrid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="OpenDumpButton" Content="打开证据目录" Click="OnOpenDumpDirectory" />
              <Button x:Name="OpenConfigButton" Content="打开配置目录" Click="OnOpenConfigDirectory" />
            </StackPanel>
            <TextBlock x:Name="HotkeyText" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" TextWrapping="Wrap"
                       Text="全局热键(游戏里直接按,不用切出来):Ctrl+Alt+T 开始/停止 · Ctrl+Alt+P 暂停/继续 · Ctrl+Alt+R 重新框选 · Ctrl+Alt+O 切换原文显示 · Ctrl+Alt+H 显示/隐藏翻译框 · Ctrl+Alt+U 解锁翻译框(解锁后可拖动、拖四角缩放)" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
