<Window x:Class="GuGuGaGaTranslator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/icon.png"
        Title="LCTA · 边狱巴士翻译助手"
        Height="780" Width="1140"
        MinHeight="660" MinWidth="900"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" MinWidth="270" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.ColumnSpan="2" Margin="0,0,0,16" Padding="14,10"
            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="4,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="UpdateBadgeButton" Content="有更新" Click="OnShowUpdates" Visibility="Collapsed"
                  Style="{StaticResource PrimaryButton}" />
          <Button Content="服务设置" Click="OnOpenSetup" />
          <Button Content="术语反馈" Click="OnTermFeedback" />
          <CheckBox x:Name="FloatingBallCheck" Content="悬浮球" Click="OnFloatingBallToggle" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <Image DockPanel.Dock="Left" Source="Assets/app-wordmark.png" Width="138" Height="62"
               Stretch="Uniform" Margin="0,0,18,0" RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="LCTA" FontFamily="{StaticResource DisplayFont}" FontSize="27" FontWeight="Bold"
                     Foreground="{StaticResource AccentBrush}" />
          <TextBlock Text="边狱巴士翻译助手 · 剧情阅读与屏幕翻译" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 目标窗口 -->
    <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
        <TextBlock Text="01 / 选择窗口与字幕区域" Style="{StaticResource TitleText}" VerticalAlignment="Center"
                   Margin="0,0,0,0" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Top" x:Name="TargetSummary" Style="{StaticResource FieldLabel}"
                 TextWrapping="Wrap" Text="尚未选择窗口" />
      <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,6,0,4">
        <Button x:Name="RefreshButton" Content="刷新列表" Click="OnRefreshWindows" />
        <Button x:Name="RegionButton" Content="框选区域" Click="OnPickRegion" />
      </UniformGrid>
      <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,0,8">
        <Button x:Name="BottomStripButton" Content="底部字幕 ▾" Click="OnBottomOptions"
                ToolTip="选择手动框选或自动预设。手动选区会保存并用于后续翻译" />
        <Button x:Name="ClearRegionButton" Content="清除区域" Click="OnClearRegion" />
      </UniformGrid>
      <CheckBox x:Name="HideOwnWindowsCheck" DockPanel.Dock="Top" Margin="0,0,0,8"
                Content="框选时隐藏翻译界面(推荐)"
                Checked="OnHideOwnWindowsChanged" Unchecked="OnHideOwnWindowsChanged"
                ToolTip="和微信截图一样:一进框选就把控制窗口、翻译框和语言条收起来,框到的就是你看到的那块屏幕;框完自动恢复。框选框里也有同一个开关,可以当场改。" />
      <ListView x:Name="WindowList" DisplayMemberPath="Display"
                SelectionChanged="OnWindowSelected" />
    </DockPanel>

    <TabControl x:Name="SettingsTabs" Grid.Row="1" Grid.Column="1">

      <TabItem Header="翻译">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Padding="10" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                  Background="{StaticResource FieldBrush}">
            <StackPanel>
              <TextBlock x:Name="RunModeText" Text="通用翻译 · 自动识别 → 中文" FontWeight="SemiBold" TextWrapping="Wrap" />
              <WrapPanel Margin="0,8,0,0">
                <Button Content="自动 → 中" Click="OnQuickAuto" MinWidth="78" />
                <Button Content="英 → 中" Click="OnQuickEnglish" MinWidth="78" />
                <Button Content="日 → 中" Click="OnQuickJapanese" MinWidth="78" />
                <Button Content="韩 → 中" Click="OnQuickKorean" MinWidth="78" />
                <Button Content="切换方向…" Click="OnMainDirections" />
                <Button Content="选择档案" Click="OnOpenProfilesTab" MinWidth="78" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <WrapPanel Grid.Row="1">
            <Button x:Name="StartButton" Content="02 / 开始翻译" Click="OnStart" Style="{StaticResource PrimaryButton}" />
            <Button x:Name="PauseButton" Content="暂停" Click="OnPause" />
            <Button x:Name="StopButton" Content="停止" Click="OnStop" />
            <Button x:Name="SaveButton" Content="保存配置" Click="OnSave" />
            <Button Content="重新尝试" Click="OnRetryCurrent" MinWidth="76" />
          </WrapPanel>

          <TextBlock Grid.Row="2" x:Name="StatusText" Text="就绪" Margin="0,10,0,0"
                     TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />

          <TextBlock Grid.Row="3" Text="识别到的原文" Style="{StaticResource FieldLabel}" Margin="0,12,0,2" />

          <TextBox Grid.Row="4" x:Name="SourceBox" IsReadOnly="True" AcceptsReturn="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   Foreground="{StaticResource SourceTextBrush}"
                   FontFamily="Consolas, Microsoft YaHei UI" />

          <DockPanel Grid.Row="5" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Top" Text="译文 · 同步显示在悬浮层" Style="{StaticResource FieldLabel}" />
            <TextBlock DockPanel.Dock="Bottom" x:Name="StatsText" Margin="0,8,0,0" Foreground="{StaticResource HintTextBrush}"
                       TextWrapping="Wrap" Text="帧 0 · 识别 0 · 翻译 0 · 缓存 0 · 去重 0 · 错误 0" />
            <TextBox x:Name="TranslationBox" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="18"
                     Foreground="{StaticResource TextBrush}"
                     FontFamily="Microsoft YaHei UI, Meiryo, Yu Gothic" />
          </DockPanel>
        </Grid>
      </TabItem>

      <TabItem Header="识别">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">

            <TextBlock Text="识别" Style="{StaticResource SectionText}" />
            <TextBlock Text="画面捕获方式" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="CaptureBackendCombo" />
            <TextBlock Style="{StaticResource HintText}" Text="窗口捕获可读取被翻译框或其他窗口遮挡的内容。兼容模式需保持选区可见；切换后点击保存。" />
            <TextBlock Text="识别引擎" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="OcrEngineCombo" SelectionChanged="OnOcrEngineChanged" />
            <TextBlock x:Name="OcrEngineSummary" Style="{StaticResource HintText}" />
            <TextBlock Text="识别语言" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="OcrLanguageCombo" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="原文为韩语时选择韩语模型；自动识别会比较通用与韩语模型，耗时更长。Windows OCR 需要对应系统语言包。" />
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="识别前放大倍数（小字建议 2–3）" />
                <TextBox x:Name="OcrScaleBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="对比度增强（正常画面保持 0）" />
                <TextBox x:Name="OcrGrayBox" />
              </StackPanel>
            </UniformGrid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button x:Name="OpenLanguageSettingsButton" Content="打开 Windows 语言设置"
                      Click="OnOpenLanguageSettings" />
              <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="6,0,0,0"
                         Text="装完「光学字符识别」功能要重启本程序" />
            </StackPanel>
            <TextBlock Text="RapidOCR 设置" Style="{StaticResource FieldLabel}" />
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="短边目标（数值越小，检测越快）" />
                <TextBox x:Name="RapidLimitSideBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="模型目录（留空时使用应用目录下的 models\v6）" />
        <DockPanel><Button Content="选择…" Click="OnBrowseModelsDirectory" DockPanel.Dock="Right" /><TextBox x:Name="RapidModelsBox" /></DockPanel>
              </StackPanel>
            </UniformGrid>

            <Separator Margin="0,10,0,10" />

            <TextBlock Text="字幕稳定等待（毫秒，0 为立即翻译）" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="TextSettleBox" />
            <TextBlock Style="{StaticResource HintText}" Text="默认等待 450 毫秒，减少逐字字幕的碎片请求；静态文章也可设为 0。修改后保存生效。" />

            <TextBlock Text="翻译方向" Style="{StaticResource SectionText}" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="这两个设置仅用于翻译。源语言选择 auto 时，由翻译引擎判断语言。" />
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="源语言(原文)" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="FromCombo" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Text="目标语言(译文)" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ToCombo" />
              </StackPanel>
            </UniformGrid>

            <Separator Margin="0,10,0,10" />

            <TextBlock Text="翻译引擎" Style="{StaticResource SectionText}" />
            <TextBlock Text="翻译引擎" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ProviderCombo" SelectionChanged="OnProviderChanged" />
            <TextBlock x:Name="ProviderCapabilitiesText" Style="{StaticResource HintText}" />
            <StackPanel x:Name="ClassicCredentialsPanel" Visibility="Collapsed">
              <StackPanel x:Name="ClassicIdPanel">
                <TextBlock Text="应用 ID / appKey" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ClassicIdBox" />
              </StackPanel>
              <TextBlock Text="应用密钥 / token（Windows 当前账户加密保存）" Style="{StaticResource FieldLabel}" />
              <PasswordBox x:Name="ClassicSecretBox" />
              <Button Content="打开服务商密钥页面" Click="OnGetApiKey" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel x:Name="AISettingsPanel">
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="常用预设（自动填写接口地址和模型）" />
            <ComboBox x:Name="PresetCombo" SelectionChanged="OnPresetChanged" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="指令格式（通用模型使用 galgame；Sakura-GalTransl 使用 sakura）" />
            <ComboBox x:Name="PromptStyleCombo" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="上下文句数（0–8；0 表示关闭）" />
            <TextBox x:Name="HistoryLinesBox" />
            <Button x:Name="SetupButton" Content="API 设置…（填写 Key / 测试连接）" Click="OnOpenSetup" Margin="0,6,0,6" Style="{StaticResource PrimaryButton}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button x:Name="GetKeyButton" Content="获取 API Key" Click="OnGetApiKey" />
              <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="6,0,0,0"
                         Text="在线服务通常需要 Key；本地模型可留空。价格和额度请以服务商页面为准。" />
            </StackPanel>

            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="接口地址（程序会自动追加 /chat/completions）" />
            <TextBox x:Name="BaseUrlBox" LostFocus="OnEngineFieldChanged" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="模型名" />
            <DockPanel>
              <Button x:Name="ReadModelsButton" Content="读取可用模型" Click="OnReadModels" DockPanel.Dock="Right" Margin="8,0,0,0" />
              <TextBox x:Name="ModelBox" LostFocus="OnEngineFieldChanged" />
            </DockPanel>
            <ComboBox x:Name="AvailableModelsCombo" SelectionChanged="OnAvailableModelChanged" Visibility="Collapsed" Margin="0,6,0,0" />
            <TextBlock x:Name="ModelsStatusText" Style="{StaticResource HintText}" Text="服务商提供地址、API Key 和模型名。读取列表不发送台词；列表中的模型不一定都支持文本聊天。" />
            <TextBlock Text="API Key（本地引擎留空）" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="ApiKeyBox" />
            </StackPanel>
            <TextBlock x:Name="EngineSummary" Foreground="{StaticResource HintTextBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,10" />
            <Button Content="清除已保存密钥" Click="OnClearApiKey" HorizontalAlignment="Left" />
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                           Text="超时（秒）" />
                <TextBox x:Name="TimeoutBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                           Text="温度（0 最稳定）" />
                <TextBox x:Name="TemperatureBox" />
              </StackPanel>
            </UniformGrid>
            <WrapPanel Margin="0,6,0,0">
              <Button x:Name="TestProviderButton" Content="测试当前服务连接" Click="OnTestProvider" />
              <Button Content="应用服务设置" Click="OnSave" />
            </WrapPanel>
            <TextBlock Style="{StaticResource HintText}" Text="测试会把一条示例文本发给当前服务，可能产生少量用量。" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="术语与游戏">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">

            <TextBlock Text="剧情档案与术语" Style="{StaticResource SectionText}" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="游戏档案可提供术语表、世界观和风格要求。启用术语校正后，已列出的错误译法会在译后替换。" />

            <TextBlock Text="当前生效的游戏档案" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="GameProfileCombo" SelectionChanged="OnGameProfileChanged" />
            <UniformGrid Columns="3" Margin="0,6,0,6">
              <Button x:Name="EditProfileButton" Content="编辑术语表…" Click="OnEditGameProfile" />
              <Button x:Name="NewProfileButton" Content="新建档案…" Click="OnNewGameProfile" />
              <Button x:Name="GenerateSheetButton" Content="生成术语表…" Click="OnGenerateTermSheet" Style="{StaticResource PrimaryButton}" />
            </UniformGrid>
            <UniformGrid Columns="2" Margin="0,0,0,6">
              <Button Content="导入档案…" Click="OnImportProfile" />
              <Button Content="导出当前档案…" Click="OnExportProfile" />
            </UniformGrid>
            <TextBlock Style="{StaticResource HintText}" Text="档案文件只包含作品设定、术语和来源信息；导入后可先编辑再保存。" />
            <Border Padding="10" Margin="0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource FieldBrush}">
              <StackPanel>
                <TextBlock Text="即时术语 · 保存后重译当前句" FontWeight="SemiBold" />
                <TextBlock Text="原文与译名" Style="{StaticResource FieldLabel}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <TextBox x:Name="QuickTermSource" ToolTip="例如 Outis。按当前翻译方向保存" Margin="0,0,6,0" />
                  <TextBox x:Name="QuickTermTarget" Grid.Column="1" ToolTip="例如 奥提斯" />
                </Grid>
                <TextBlock Text="需要纠正的旧译名（可选，用逗号分隔）" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="QuickTermWrong" />
                <WrapPanel><Button Content="添加并立即应用" Click="OnAddQuickTerm" Style="{StaticResource PrimaryButton}" />
                  <Button Content="管理个人术语…" Click="OnManagePersonalTerms" /></WrapPanel>
                <TextBlock Text="个人术语优先，公共词库更新会保留这些修改。四种语言分别保存，不混用译名。" Style="{StaticResource HintText}" />
                <TextBlock Text="普通翻译接口不接收术语提示；若译名仍未改变，请在上方填写它给出的旧译名，用于本机校正。" Style="{StaticResource HintText}" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="GameProfileSummary" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
            <Button Content="从内置边狱档案新建副本…" Click="OnRestoreLimbus" HorizontalAlignment="Left"
                    ToolTip="打开内置术语的副本供核对和保存；不会覆盖个人档案" />
            <Button x:Name="PreviewPromptButton" Content="查看实际发送给 AI 的提示词…" Click="OnPreviewPrompt" Margin="0,6,0,0" />

            <Separator Margin="0,10,0,10" />

            <CheckBox x:Name="AutoProfileCheck" Content="按窗口标题或进程自动匹配档案" Click="OnProfileOptionChanged" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="选择目标窗口时自动匹配档案；手动选择优先。不同目标分别记住选区、档案和语言方向。" />
            <CheckBox x:Name="EnforceTermsCheck" Content="已匹配术语的译后校正" Click="OnProfileOptionChanged" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="将已列出的禁止译法替换为既定译名，并补齐未翻译术语。" />

            <Separator Margin="0,10,0,10" />

            <TextBlock Text="术语表的写法" Style="{StaticResource SectionText}" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="每行一条:原文 = 译名 | 禁止: 错误译法1、错误译法2     (# 开头是注释)" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="行首用 en: / ja: / zh: 标记原文语言。译成中文时取源语言条目，中文译成外语时反向使用，日英互译时通过中文译名配对。不标语言时兼容旧格式。" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="en: Outis = 奥提斯 | 禁止: 奥德修斯、奥蒂斯" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="ja: ウーティス = 奥提斯 | 禁止: 奥德修斯、奥蒂斯" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="原文和译名相同表示保留该词。禁止译法填写目标语言中的常见错译，启用术语校正后会替换为既定译名。保存前请核对条目。" />

            <Separator Margin="0,10,0,10" />

            <TextBlock Text="自己写一款新游戏" Style="{StaticResource SectionText}" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="1. 点「新建档案…」,填名称(例如 边狱巴士 / Limbus Company)。" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="2. 点击“生成 / 补全术语表”。AI 会按官方简中译名起草；游戏名留空时，会根据台词尝试识别作品。" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="3. 核对生成结果，修改译名并补充禁止译法，再保存档案。" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="世界观应简短说明作品和主要设定。" />

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="悬浮层">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">

            <TextBlock Text="外观预设" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="OverlayPresetCombo" SelectionChanged="OnOverlayPresetChanged" />
            <TextBlock x:Name="OverlayPresetSummary" Foreground="{StaticResource HintTextBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,10" />

            <TextBlock Text="翻译框位置" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="PlacementCombo" SelectionChanged="OnOverlayFieldChanged" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="遮盖原文 = 翻译框盖在原对话框上(galgame 最常见);下方 / 上方 = 保留原文,译文贴在对话框下沿或上沿。" />

            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="字号" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="OverlayFontBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Text="背景不透明度(0–1)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="OverlayOpacityBox" />
              </StackPanel>
            </UniformGrid>
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="水平偏移" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="OverlayOffsetXBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Text="垂直偏移(负值上移)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="OverlayOffsetYBox" />
              </StackPanel>
            </UniformGrid>
            <CheckBox x:Name="ShowPanelCheck" Content="显示翻译框底框(关掉只剩带描边的文字)" />
            <CheckBox x:Name="ShowSourceCheck" Content="同时显示识别到的原文" />
            <CheckBox x:Name="TextOutlineCheck" Content="文字描边(底框关掉后靠它保证可读)" />
            <CheckBox x:Name="ClickThroughCheck" Content="翻译框鼠标穿透（控制条的拖动柄始终可用）" />
            <CheckBox x:Name="LanguageBarCheck" Content="在悬浮层上方显示语言切换条" />
            <TextBlock Style="{StaticResource HintText}" Text="拖动控制条左端的柄可移动整组悬浮层；点击右端 × 关闭并停止翻译。长译文可在编辑模式下滚动查看。" />
            <CheckBox x:Name="ExcludeFromCaptureCheck" Content="翻译框不被录屏/截图拍到(想录下翻译过程就取消勾选)"
                      Checked="OnExcludeFromCaptureChanged" Unchecked="OnExcludeFromCaptureChanged" />
            <Separator Margin="0,8,0,8" />
            <TextBlock Text="翻译框宽 / 高(像素;0 = 宽跟随所选区域、高随文字)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBox x:Name="OverlayWidthBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBox x:Name="OverlayHeightBox" />
              </StackPanel>
            </UniformGrid>
            <TextBlock Text="最大行数（0 不限制） / 圆角 / 内边距" Style="{StaticResource FieldLabel}" />
            <UniformGrid Columns="3">
              <StackPanel Margin="0,0,6,0">
                <TextBox x:Name="OverlayMaxLinesBox" />
              </StackPanel>
              <StackPanel Margin="3,0,3,0">
                <TextBox x:Name="OverlayCornerBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBox x:Name="OverlayPaddingBox" />
              </StackPanel>
            </UniformGrid>
            <TextBlock Text="字体(留空 = 系统默认)" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="OverlayFontFamilyBox" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="全部外观都能在 config.json 的 overlay 段里改;想加一套新外观,往 overlay.presets 里加一条即可,不用改代码。" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="热键">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="全局快捷键" Style="{StaticResource SectionText}" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Text="点击输入框后直接按组合键。组合键至少包含 Ctrl、Alt、Shift 或 Win；Backspace 清除，Esc 取消录入。" />
            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="“一键框选并翻译”会在确认选区后开始翻译；未选择目标窗口时使用当前前台窗口。" />
            <StackPanel x:Name="HotkeyRows" Margin="0,14,0,0" />
            <Button x:Name="HotkeyResetButton" Content="恢复默认快捷键" Click="OnResetHotkeys"
                    HorizontalAlignment="Left" Padding="10,6" />
            <TextBlock x:Name="HotkeyStatus" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="支持">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="翻译缓存" Style="{StaticResource SectionText}" />
            <CheckBox x:Name="CacheEnabledCheck" Content="启用翻译缓存，重复台词直接复用译文" />
            <CheckBox x:Name="PersistentCacheCheck" Content="把翻译缓存保存在本机，重启后仍可复用（可选）" IsEnabled="{Binding IsChecked, ElementName=CacheEnabledCheck}" />
            <CheckBox x:Name="CacheContextCheck" Content="匹配上下文（推荐；同一句在不同语境中分别缓存）" />
            <TextBlock x:Name="CacheStatusText" Style="{StaticResource HintText}" />
            <TextBlock Style="{StaticResource HintText}" Text="默认仅用内存。关闭上下文匹配可减少重复请求，但可能复用不适合当前语境的译文；模型、方向和术语仍分别缓存。关闭缓存后停止读写，不自动删除旧文件。" />
            <TextBlock Text="内存最多条数（100–20000）" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="CacheMemoryBox" />
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="磁盘保留天数（1–365）" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="CacheRetentionBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Text="最大磁盘条数（100–100000）" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="CacheCapacityBox" />
              </StackPanel>
            </UniformGrid>
            <WrapPanel Margin="0,6,0,0">
              <Button Content="应用缓存设置" Click="OnSave" />
              <Button x:Name="ClearCacheButton" Content="删除内存和磁盘缓存" Click="OnClearCache" />
              <Button Content="仅清空内存" Click="OnClearMemoryCache" />
              <Button Content="清理过期缓存" Click="OnPruneCache" />
              <Button Content="刷新统计" Click="OnRefreshCacheStats" />
            </WrapPanel>
            <Separator Margin="0,16" />
            <TextBlock Text="文件保存位置" Style="{StaticResource SectionText}" />
            <TextBlock Text="数据目录：配置、密钥、个人术语和默认保存目录。迁移会停止翻译，保留原目录备份。" Style="{StaticResource HintText}" />
            <DockPanel><Button Content="选择…" Click="OnBrowseDataRoot" DockPanel.Dock="Right" /><TextBox x:Name="DataRootBox" /></DockPanel>
            <WrapPanel><Button x:Name="MigrateDataButton" Content="迁移到此数据目录" Click="OnMigrateData" /><Button Content="打开数据目录" Click="OnOpenConfigDirectory" /></WrapPanel>
            <TextBlock Text="以下项目留空时跟随数据目录，也可分别选择。修改后先点击应用；迁移仅改变数据目录，已有自定义路径保留。" Style="{StaticResource HintText}" />
            <TextBlock Text="翻译缓存目录" Style="{StaticResource FieldLabel}" />
            <DockPanel><Button Content="选择…" Click="OnBrowseCacheDirectory" DockPanel.Dock="Right" /><TextBox x:Name="CacheDirectoryBox" /></DockPanel>
            <TextBlock Text="运行日志目录" Style="{StaticResource FieldLabel}" />
            <DockPanel><Button Content="选择…" Click="OnBrowseLogDirectory" DockPanel.Dock="Right" /><TextBox x:Name="LogDirectoryBox" /></DockPanel>
            <TextBlock Text="档案与诊断包默认导出目录" Style="{StaticResource FieldLabel}" />
            <DockPanel><Button Content="选择…" Click="OnBrowseExportDirectory" DockPanel.Dock="Right" /><TextBox x:Name="ExportDirectoryBox" /></DockPanel>
            <TextBlock Text="程序更新默认下载目录" Style="{StaticResource FieldLabel}" />
            <DockPanel><Button Content="选择…" Click="OnBrowseUpdateDirectory" DockPanel.Dock="Right" /><TextBox x:Name="UpdateDirectoryBox" /></DockPanel>
            <Button Content="应用文件位置" Click="OnApplyStorage" HorizontalAlignment="Left" />
            <TextBlock x:Name="StorageStatusText" Style="{StaticResource HintText}" />
            <Separator Margin="0,16,0,16" />
            <TextBlock Text="程序与公共词库更新" Style="{StaticResource SectionText}" />
            <TextBlock x:Name="UpdateStatusText" Text="点击检查更新获取正式版本与公共词库信息" TextWrapping="Wrap" Style="{StaticResource HintText}" />
            <CheckBox x:Name="StartupUpdateCheck" Content="启动时检查更新（每天最多一次）" Click="OnUpdateOptionsChanged" />
            <CheckBox x:Name="AutoTermsCheck" Content="自动应用已校验的公共词库更新，保留个人修改" Click="OnUpdateOptionsChanged" />
            <WrapPanel>
              <Button x:Name="CheckUpdatesButton" Content="检查更新" Click="OnCheckUpdates" />
              <Button x:Name="ApplyTermsButton" Content="更新公共词库" Click="OnApplyTermsUpdate" IsEnabled="False" />
              <Button x:Name="InstallUpdateButton" Content="下载并安装新版" Click="OnInstallAppUpdate" IsEnabled="False" />
            </WrapPanel>
            <TextBlock Text="程序安装需手动启动；公共词库可自动或手动更新。更新只访问维护者 GitHub 仓库，不发送台词、截图或密钥。" Style="{StaticResource HintText}" />
            <Separator Margin="0,14" />
            <TextBlock Text="诊断与支持" Style="{StaticResource SectionText}" />
            <TextBlock Style="{StaticResource HintText}" Text="诊断包包含版本、系统、脱敏设置、状态和耗时日志。不包含 API Key、接口地址、窗口标题、截图、台词、译文或游戏档案；不会自动上传。" />
            <Button Content="导出诊断包…" Click="OnExportDiagnostics" HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="调试">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <CheckBox x:Name="DumpFramesCheck" Content="把每一帧识别证据写到磁盘(PNG + JSON)" />
            <TextBlock Text="证据目录" Style="{StaticResource FieldLabel}" />
            <DockPanel><Button Content="选择…" Click="OnBrowseDumpDirectory" DockPanel.Dock="Right" /><TextBox x:Name="DumpDirBox" ToolTip="留空时保存到数据目录下的 dumps" /></DockPanel>
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="保留最近多少对" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="DumpKeepBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Text="轮询间隔(毫秒)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="PollIntervalBox" />
              </StackPanel>
            </UniformGrid>
            <UniformGrid Columns="2">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="变化阈值(256 格中变了多少格才重新识别)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                <TextBox x:Name="ChangeThresholdBox" />
              </StackPanel>
              <StackPanel Margin="6,0,0,0">
                <TextBlock Text="强制刷新间隔(毫秒)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ForceRefreshBox" />
              </StackPanel>
            </UniformGrid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="OpenDumpButton" Content="打开证据目录" Click="OnOpenDumpDirectory" />
              <Button x:Name="OpenConfigButton" Content="打开配置目录" Click="OnOpenConfigDirectory" />
            </StackPanel>
            <TextBlock x:Name="HotkeyText" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" TextWrapping="Wrap"
                       Text="全局热键(游戏里直接按,不用切出来):Ctrl+Alt+T 开始/停止 · Ctrl+Alt+P 暂停/继续 · Ctrl+Alt+R 重新框选 · Ctrl+Alt+O 切换原文显示 · Ctrl+Alt+H 显示/隐藏翻译框 · Ctrl+Alt+U 解锁翻译框(解锁后可拖动、拖四角缩放)" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
