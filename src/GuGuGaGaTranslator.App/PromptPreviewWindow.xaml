<Window x:Class="GuGuGaGaTranslator.App.PromptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/icon.png"
        Title="实际发送给 AI 的提示词"
        Height="720" Width="980"
        MinHeight="420" MinWidth="640"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
               Text="此窗口显示每次翻译发送的完整请求，包括规则、术语表、世界观和上下文。" />

    <TextBlock Grid.Row="1" x:Name="ProfileText" Margin="0,8,0,8"
               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />

    <TextBlock Grid.Row="2" Text="System：规则、术语表、世界观" Style="{StaticResource FieldLabel}" />
    <TextBox Grid.Row="3" x:Name="SystemBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" Margin="0,2,0,10"
             FontFamily="Consolas, Microsoft YaHei UI" />

    <TextBlock Grid.Row="4" Text="User：上下文和当前原文" Style="{StaticResource FieldLabel}" />
    <TextBox Grid.Row="5" x:Name="UserBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" Margin="0,2,0,10"
             FontFamily="Consolas, Microsoft YaHei UI" />

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CopyButton" Content="复制全部" Click="OnCopy" />
      <Button x:Name="CloseButton" Content="关闭" Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>
