<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF 界面，翻译和抓屏逻辑由 Core 提供。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GuGuGaGaTranslator.App</RootNamespace>
    <AssemblyName>GuGuGaGaTranslator</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>


    <!-- 社区图标的来源和 CC BY-NC-SA 4.0 署名见 THIRD_PARTY_NOTICES.md。 -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GuGuGaGaTranslator.Core\GuGuGaGaTranslator.Core.csproj" />
    <ProjectReference Include="..\GuGuGaGaTranslator.Ocr.Rapid\GuGuGaGaTranslator.Ocr.Rapid.csproj" />
    <ProjectReference Include="..\GuGuGaGaTranslator.Storage.Sqlite\GuGuGaGaTranslator.Storage.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup><Compile Include="..\Shared\InstallationManifest.cs" Link="InstallationManifest.cs" /></ItemGroup>
</Project>
