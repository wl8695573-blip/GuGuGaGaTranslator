<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF 界面，翻译和抓屏逻辑由 Core 提供。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GuGuGaGaTranslator.App</RootNamespace>
    <AssemblyName>LCTA</AssemblyName>
    <Title>LCTA</Title>
    <Product>LCTA</Product>
    <Description>LCTA 屏幕翻译助手</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>


    <!-- 维护者选定的“边·译”图标，来源说明见 THIRD_PARTY_NOTICES.md。 -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\lcta-wordmark.png" />
    <Resource Include="Assets\app-wordmark.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GuGuGaGaTranslator.Core\GuGuGaGaTranslator.Core.csproj" />
    <ProjectReference Include="..\GuGuGaGaTranslator.Ocr.Rapid\GuGuGaGaTranslator.Ocr.Rapid.csproj" />
    <ProjectReference Include="..\GuGuGaGaTranslator.Storage.Sqlite\GuGuGaGaTranslator.Storage.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup><Compile Include="..\Shared\InstallationManifest.cs" Link="InstallationManifest.cs" /></ItemGroup>
  <ItemGroup>
    <Content Include="../../terminology/*.json" Link="terminology/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
